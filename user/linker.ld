ENTRY(_start)

SECTIONS
{
    /* Userland binaries are linked at virtual address 1GB */
    . = 0x40000000;

    .text : {
        *(.text .text.*)
    }

    .rodata : {
        *(.rodata .rodata.*)
    }

    .data : {
        *(.data .data.*)
    }

    .bss : {
        *(.bss .bss.*)
        *(COMMON)
    }
}
